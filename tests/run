#!/usr/bin/env bash
# Tests for git-leakguard, git-whoami, the hooks and the installer. Builds
# throwaway repos and a throwaway home; touches nothing else.
set -u
root=$(cd "$(dirname "$0")/.." && pwd)
guard=$root/bin/git-leakguard
whoami=$root/bin/git-whoami
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

export GIT_CONFIG_GLOBAL=$tmp/gitconfig GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=alice GIT_AUTHOR_EMAIL=alice@example.com
export GIT_COMMITTER_NAME=alice GIT_COMMITTER_EMAIL=alice@example.com

# Stand-ins, so results don't depend on this machine's ~/.ssh/config or the
# network. Only someone/* is public, unless the guard's own git can still see a
# URL rewrite or a login, which is how a private repo would pass for public.
REAL_GIT=$(command -v git)
export REAL_GIT
mkdir "$tmp/stubs"
cat >"$tmp/stubs/ssh" <<'STUB'
#!/usr/bin/env bash
printf 'hostname %s\nidentityfile %s\n' "${STUB_SSH_HOSTNAME:-$2}" "${STUB_SSH_KEY:-$HOME/.ssh/alice}"
STUB
cat >"$tmp/stubs/git" <<'STUB'
#!/usr/bin/env bash
[ "${1-}" = ls-remote ] || exec "$REAL_GIT" "$@"
[ -z "${STUB_HANG-}" ] || exec sleep 30
"$REAL_GIT" config --get-regexp '^(url|credential)\.' >/dev/null 2>&1 && exit 0
case $2 in https://github.com/someone/*) exit 0 ;; *) exit 128 ;; esac
STUB
chmod +x "$tmp/stubs/ssh" "$tmp/stubs/git"
export PATH=$tmp/stubs:$PATH

cat >"$GIT_CONFIG_GLOBAL" <<'EOF'
[init]
	defaultBranch = main
[identity]
	active = alice
[leak]
	term = Secret-Host
	regex = "tok_[a-z0-9]{8}"
	private = alice/notes
[leak "alice"]
	term = other-account
[leak "bob"]
	term = alice-only-word
EOF

public=git@github.com:alice/site.git
clean=0 blocked=1 error=2
pass=0 fail=0

expect() { # <name> <exit code> <command...>
	local name=$1 want=$2 got=0
	shift 2
	"$@" >/dev/null 2>&1 || got=$?
	if [ "$got" -eq "$want" ]; then
		pass=$((pass + 1))
	else
		fail=$((fail + 1))
		echo "FAIL: $name: exit $got, wanted $want"
	fi
}

fresh() {
	cd "$tmp" || exit 1
	rm -rf "$tmp/repo"
	git init -q "$tmp/repo"
	cd "$tmp/repo" || exit 1
	echo hello >README
	git add README
	git commit -qm first
	git remote add origin "$public"
	git update-ref refs/remotes/origin/main HEAD
}

commit_file() { # <file> <line>
	printf '%s\n' "$2" >>"$1"
	git add "$1"
	git commit -qm "change $1"
}

update() { # <object> <remote ref>
	printf 'refs/local %s %s %040d\n' "$(git rev-parse "$1")" "$2" 0
}

push() { # [url]
	update HEAD refs/heads/main | "$guard" --pre-push origin "${1:-$public}"
}

push_ref() { # <object> <remote ref>
	update "$1" "$2" | "$guard" --pre-push origin "$public"
}

push_hook() {
	update HEAD refs/heads/main | "$root/hooks/pre-push" origin "$public"
}

fresh; commit_file a.txt 'nothing to see'
expect "clean commit" $clean push

fresh; commit_file a.txt 'ssh SECRET-host now'
expect "term in an added line, any case" $blocked push

fresh; commit_file a.txt 'key tok_ab12cd34 here'
expect "regex" $blocked push

fresh; commit_file a.txt 'key TOK_AB12CD34 here'
expect "regex against the lowercased line" $blocked push

fresh; commit_file a.txt 'said other-account here'
expect "term for the active identity" $blocked push

fresh; commit_file a.txt 'said alice-only-word here'
expect "term for another identity" $clean push

fresh; commit_file a.txt secret-host
git update-ref refs/remotes/origin/main HEAD
git rm -q a.txt; git commit -qm remove
expect "removing a leak" $clean push

fresh; : >secret-host.txt; git add .; git commit -qm 'empty file'
expect "new empty file's name" $blocked push

fresh; git commit -q --allow-empty -m 'fixes secret-host'
expect "commit message" $blocked push

fresh; GIT_AUTHOR_EMAIL=me@secret-host.example git commit -q --allow-empty -m x
expect "author email" $blocked push

fresh; GIT_COMMITTER_EMAIL=me@secret-host.example git commit -q --allow-empty -m x
expect "committer email" $blocked push

fresh; printf 'a\0secret-host\0b\n' >blob.bin; git add .; git commit -qm binary
expect "binary file" $blocked push

fresh; printf 'a\0tok_ab12cd34\0b\n' >blob.bin; git add .; git commit -qm binary
expect "regex skips a binary file" $clean push

fresh; git checkout -qb side; commit_file side.txt ok; git checkout -q main
commit_file main.txt ok
git merge -q --no-commit side >/dev/null; echo secret-host >>side.txt; git add side.txt
git commit -qm merge
expect "line added in a merge commit" $blocked push

fresh; commit_file a.txt secret-host
git update-ref refs/remotes/origin/main HEAD
commit_file b.txt fine
expect "commit already on this remote" $clean push

fresh; commit_file a.txt secret-host
git update-ref refs/remotes/upstream/main HEAD
git remote add upstream https://github.com/someone/site.git
expect "commit already on a public upstream" $clean push

git remote set-url --push upstream no_push
expect "public upstream with no_push as its push URL" $clean push

STUB_HANG=1 GIT_LEAKGUARD_TIMEOUT=1 expect "a remote that doesn't answer in time" $blocked push

fresh; commit_file a.txt secret-host
git update-ref refs/remotes/work/main HEAD
git remote add work git@github.com:acme/internal.git
expect "commit on an unlisted private remote" $blocked push

git config url.git@github.com:.insteadOf https://github.com/
git config credential.helper store
expect "local config can't make a remote look public" $blocked push
git config --unset url.git@github.com:.insteadOf
git config --unset credential.helper

git config --global url.git@github.com:.insteadOf https://github.com/
expect "global config can't make a remote look public" $blocked push
git config --global --unset url.git@github.com:.insteadOf

fresh; commit_file a.txt secret-host
git update-ref refs/remotes/mirror/main HEAD
git remote add mirror git@github.com:alice/notes.git
expect "commit only on a private remote" $blocked push

fresh; commit_file a.txt secret-host
git update-ref refs/remotes/backup/main HEAD
git remote add backup /srv/git/site.git
expect "commit only on a local remote" $blocked push

fresh; git update-ref -d refs/remotes/origin/main
git commit -q --amend -m 'first, from secret-host'
expect "first push reaches the root commit" $blocked push

fresh; git update-ref -d refs/remotes/origin/main
echo secret-host >a.txt; git add .; git commit -q --amend -m first
git config log.showRoot false
expect "root commit's files with log.showRoot off" $blocked push
expect "history scan with log.showRoot off" $blocked "$guard"

fresh; : >Åse-cv.txt; git add .; git commit -qm 'new file'
git config leak.term Åse
expect "non-ASCII file name" $blocked push

fresh; commit_file a.txt secret-host
expect "private repo" $clean push git@github.com:alice/notes.git
expect "private repo, any case" $clean push https://github.com/ALICE/Notes.git/
expect "another repo of that owner" $blocked push git@github.com:alice/notes2.git
expect "https public repo" $blocked push https://github.com/alice/site
expect "not GitHub" $clean push git@gitlab.example:alice/site.git
expect "local path" $clean push /srv/git/site.git
expect "file url" $clean push file:///srv/git/site.git
export STUB_SSH_HOSTNAME=ssh.github.com
expect "GitHub over port 443" $blocked push git@github.com:alice/site.git
expect "https with GitHub over port 443" $blocked push https://github.com/alice/site
export STUB_SSH_HOSTNAME=gitlab.example
expect "https host isn't resolved through ssh" $blocked push https://github.com/alice/site
unset STUB_SSH_HOSTNAME

fresh; commit_file a.txt fine
expect "ref name" $blocked push_ref HEAD refs/heads/secret-host

fresh; git tag -a v1 -m 'built on secret-host'
expect "tag message" $blocked push_ref v1 refs/tags/v1

fresh; commit_file a.txt secret-host
expect "branch deletion" $clean \
	bash -c "printf '(delete) %040d refs/heads/old %040d\n' 0 1 | '$guard' --pre-push origin $public"

fresh; commit_file a.txt secret-host
git update-ref refs/remotes/origin/main HEAD
expect "history scan sees what's already pushed" $blocked "$guard"

fresh; commit_file a.txt fine
expect "clean history scan" $clean "$guard"

fresh; commit_file a.txt fine
git config --add leak.regex '(unclosed'
expect "a broken regex blocks the push" $error push
git config --unset-all leak.regex

warned() { push "$public" 2>&1 | grep -q 'lowercased first'; }

fresh; commit_file a.txt fine
git config --add leak.regex 'AKIA[0-9A-Z]{16}'
expect "an uppercase regex gets a warning" $clean warned
git config --unset-all leak.regex
git config --add leak.regex '\Stok_x'
expect "an uppercase escape gets no warning" $blocked warned
git config --unset-all leak.regex

mkdir "$tmp/oldawk"
printf '#!/bin/sh\nexit 0\n' | tee "$tmp/oldawk/awk" >"$tmp/oldawk/gawk"
chmod +x "$tmp/oldawk/awk" "$tmp/oldawk/gawk"
fresh; commit_file a.txt fine
PATH=$tmp/oldawk:$PATH expect "an awk that would miss leaks blocks the push" $error push
PATH=$tmp/oldawk:$PATH expect "that awk doesn't matter off GitHub" $clean push /srv/git/site.git

fresh; git commit -q --allow-empty -m $'@@@diff\n\nfrom secret-host'
expect "a commit message that looks like a marker" $blocked push

fresh; git tag -a v1 -m $'@@@diff\n\nbuilt on secret-host'
expect "a tag message that looks like a marker" $blocked push_ref v1 refs/tags/v1

fresh; blob=$(echo 'from secret-host' | git hash-object -w --stdin)
git tag -a v1 -m tagged "$blob"
expect "annotated tag on a blob" $blocked push_ref v1 refs/tags/v1
git tag v2 "$blob"
expect "lightweight tag on a blob" $blocked push_ref v2 refs/tags/v2
expect "history scan of a tagged blob" $blocked "$guard"

fresh; blob=$(echo fine | git hash-object -w --stdin)
git tag v1 "$blob"
expect "tag on a clean blob" $clean push_ref v1 refs/tags/v1

fresh; echo fine >secret-host.txt; git add .; git commit -qm 'public file'
git update-ref refs/remotes/origin/main HEAD
echo more >>secret-host.txt; git commit -qam edit
expect "editing a file already public under that name" $clean push

fresh; commit_file a.txt '++ secret-host'
expect "an added line that starts with ++" $blocked push

fresh; commit_file a.txt fine
expect "the pre-push hook passes a clean push" $clean push_hook

fresh; commit_file a.txt secret-host
expect "the pre-push hook runs the guard" $blocked push_hook

identities() {
	git config identity.alice.email alice@example.com
	git config identity.alice.sshkey ~/.ssh/alice.pub
	git config identity.bob.email bob@example.com
	git config identity.bob.sshkey ~/.ssh/bob.pub
}

push_whoami() {
	update HEAD refs/heads/main | "$whoami" --pre-push origin "$public"
}

fresh; identities
expect "everything agrees" $clean "$whoami" --check
GIT_AUTHOR_EMAIL=bob@example.com expect "another identity's author email" $blocked "$whoami" --check
GIT_COMMITTER_EMAIL=bob@example.com expect "another identity's committer email" $blocked "$whoami" --check
GIT_AUTHOR_EMAIL=me@example.org expect "an email nobody lists" $clean "$whoami" --check

export STUB_SSH_KEY=$HOME/.ssh/bob
expect "another identity's key" $blocked "$whoami" --check
STUB_SSH_HOSTNAME=ssh.github.com expect "key over port 443" $blocked "$whoami" --check
STUB_SSH_HOSTNAME=gitlab.example expect "key on another host" $clean "$whoami" --check
git remote set-url origin github-bob:alice/site.git
STUB_SSH_HOSTNAME=github.com expect "another identity's key through an alias" $blocked "$whoami" --check
STUB_SSH_KEY=$HOME/.ssh/alice STUB_SSH_HOSTNAME=github.com \
	expect "the right key through an alias" $clean "$whoami" --check
STUB_SSH_KEY=$HOME/.ssh/stranger STUB_SSH_HOSTNAME=github.com \
	expect "a key no identity lists" $blocked "$whoami" --check
unset STUB_SSH_KEY

git remote set-url origin git@github.com:bob/site.git
expect "repo owned by another identity" $blocked "$whoami" --check
git remote set-url origin git@github.com:someone/site.git
expect "repo owned by someone else" $clean "$whoami" --check
git remote set-url origin https://github.com/bob/site.git
expect "owner over https" $blocked "$whoami" --check

fresh; identities
git remote add upstream git@github.com:bob/site.git
expect "a remote this branch doesn't push to" $clean "$whoami" --check
expect "that remote gets a note" $clean bash -c "'$whoami' --check 2>&1 | grep -q 'note: upstream'"
expect "the report still flags that remote" $blocked "$whoami"
git config remote.pushDefault upstream
expect "the remote.pushDefault remote" $blocked "$whoami" --check
git config --unset remote.pushDefault
git config branch.main.pushRemote upstream
expect "the branch's pushRemote" $blocked "$whoami" --check
git config --unset branch.main.pushRemote
git config branch.main.remote upstream
expect "the branch's remote" $blocked "$whoami" --check

fresh; identities
git remote rename origin github
git remote set-url github git@github.com:bob/site.git
expect "a lone remote not called origin" $blocked "$whoami" --check

fresh; identities
git checkout -q --detach
git remote set-url origin git@github.com:bob/site.git
expect "a detached HEAD" $blocked "$whoami" --check

fresh; identities; commit_file a.txt fine
expect "push of your own commit" $clean push_whoami

fresh; identities
GIT_AUTHOR_EMAIL=bob@example.com git commit -q --allow-empty -m x
expect "push of another identity's author" $blocked push_whoami
git update-ref refs/remotes/origin/main HEAD
expect "that commit already on a remote" $clean push_whoami

fresh; identities
GIT_COMMITTER_EMAIL=bob@example.com git commit -q --allow-empty -m x
expect "push of another identity's committer" $blocked push_whoami

fresh; identities
expect "branch deletion, identity check" $clean \
	bash -c "printf '(delete) %040d refs/heads/old %040d\n' 0 1 | '$whoami' --pre-push origin $public"

fresh; identities
git config core.hooksPath .husky/_
expect "a repo's own hooks path gets a note" $clean bash -c "'$whoami' 2>&1 | grep -q 'hooks run from'"
git config core.hooksPath "$root/hooks"
expect "the global hooks get no note" $blocked bash -c "'$whoami' 2>&1 | grep -q 'hooks run from'"

repo_hook() { # <hook file> <exit code>
	mkdir -p "$(dirname "$1")"
	cat >"$1" <<HOOK
#!/usr/bin/env bash
cat >"$tmp/hook-stdin"
echo "\$*" >"$tmp/hook-args"
exit $2
HOOK
	chmod +x "$1"
}

expect_hook_got() { # <name> <file> <text>
	expect "$1" $clean grep -q -- "$3" "$tmp/$2"
}

fresh; git config core.hooksPath "$root/hooks"
repo_hook .git/hooks/pre-commit 1
expect "a repo's pre-commit can stop a commit" $blocked git commit -q --allow-empty -m x

merge_setup() {
	fresh; identities
	git checkout -q -b side; commit_file side.txt ok
	git checkout -q main; commit_file main.txt ok
	git config core.hooksPath "$root/hooks"
}

merge_setup
GIT_AUTHOR_EMAIL=bob@example.com expect "a merge as another identity" $blocked git merge -q --no-edit side
merge_setup
expect "a merge as yourself" $clean git merge -q --no-edit side

bare=$tmp/bare.git
fresh; git config core.hooksPath "$root/hooks"
rm -rf "$bare"; git init -q --bare "$bare"; git remote add backup "$bare"
repo_hook .git/hooks/pre-push 0
git push -q backup main 2>/dev/null
expect_hook_got "a repo's pre-push gets its arguments" hook-args "^backup $bare\$"
expect_hook_got "a repo's pre-push gets its stdin" hook-stdin refs/heads/main
repo_hook .git/hooks/pre-push 1
commit_file a.txt fine
expect "a repo's pre-push can stop a push" $blocked git push -q backup main

receiving() {
	rm -rf "$bare" "$tmp/hook-args" "$tmp/hook-stdin"
	git init -q --bare "$bare"
	git -C "$bare" config core.hooksPath "$root/hooks"
}

for name in pre-receive update post-receive post-update; do
	fresh; receiving
	repo_hook "$bare/hooks/$name" 0
	git push -q "$bare" main 2>/dev/null
	expect "a bare repo's $name runs" $clean test -f "$tmp/hook-args"
done

fresh; receiving
repo_hook "$bare/hooks/post-receive" 0
git push -q "$bare" main 2>/dev/null
expect_hook_got "a bare repo's post-receive gets its stdin" hook-stdin refs/heads/main

fresh; receiving
repo_hook "$bare/hooks/pre-receive" 1
expect "a bare repo's pre-receive can reject a push" $blocked git push -q "$bare" main

fresh; rm -rf "$tmp/target"; git clone -q . "$tmp/target"
git -C "$tmp/target" config receive.denyCurrentBranch updateInstead
git -C "$tmp/target" config core.hooksPath "$root/hooks"
commit_file a.txt pushed
git push -q "$tmp/target" main 2>/dev/null
expect "updateInstead updates the working tree" $clean test -f "$tmp/target/a.txt"
expect "updateInstead leaves nothing staged" $clean git -C "$tmp/target" diff --quiet --cached HEAD

expect "no link slows every ref update" $blocked test -e "$root/hooks/reference-transaction"

sandbox=$tmp/home
in_sandbox() {
	env -u XDG_CONFIG_HOME -u GIT_CONFIG_GLOBAL -u BIN_DIR HOME="$sandbox" "$@"
}
hooks_path() { in_sandbox git config --global core.hooksPath; }

mkdir "$sandbox"
expect "install" $clean in_sandbox "$root/install.sh"
expect "install links git-whoami" $clean test "$root/bin/git-whoami" = "$(readlink "$sandbox/.local/bin/git-whoami")"
expect "install links git-leakguard" $clean test "$root/bin/git-leakguard" = "$(readlink "$sandbox/.local/bin/git-leakguard")"
expect "install links the hooks" $clean test "$root/hooks" = "$(readlink "$sandbox/.config/git/hooks")"
expect "install sets core.hooksPath" $clean test "$sandbox/.config/git/hooks" = "$(hooks_path)"

expect "installing again" $clean in_sandbox "$root/install.sh"

first=$tmp/first moved=$tmp/moved
mkdir "$first"; cp -a "$root/bin" "$root/hooks" "$root/install.sh" "$first"
expect "install won't take over another checkout's links" $blocked in_sandbox "$first/install.sh"
expect "the other checkout keeps its link" $clean test "$root/bin/git-whoami" = "$(readlink "$sandbox/.local/bin/git-whoami")"
in_sandbox "$root/install.sh" --uninstall >/dev/null 2>&1
in_sandbox "$first/install.sh" >/dev/null 2>&1
mv "$first" "$moved"
expect "re-link after moving" $clean in_sandbox "$moved/install.sh"
expect "re-link updates the hooks link" $clean test "$moved/hooks" = "$(readlink "$sandbox/.config/git/hooks")"

in_sandbox git config --global identity.active alice
expect "uninstall" $clean in_sandbox "$moved/install.sh" --uninstall
expect "uninstall removes the hooks link" $blocked test -L "$sandbox/.config/git/hooks"
expect "uninstall removes the commands" $blocked test -L "$sandbox/.local/bin/git-whoami"
expect "uninstall unsets core.hooksPath" $clean test -z "$(hooks_path)"
expect "uninstall keeps your identities" $clean in_sandbox git config --global identity.active

mkdir -p "$sandbox/.config/git/hooks"
expect "install won't replace a real directory" $blocked in_sandbox "$root/install.sh"
rmdir "$sandbox/.config/git/hooks"
mkdir "$tmp/dotfiles"; ln -s "$tmp/dotfiles" "$sandbox/.config/git/hooks"
expect "install won't replace a dotfiles link" $blocked in_sandbox "$root/install.sh"
expect "the dotfiles link stays" $clean test "$tmp/dotfiles" = "$(readlink "$sandbox/.config/git/hooks")"
rm "$sandbox/.config/git/hooks"
in_sandbox git config --global core.hooksPath /somewhere/else
expect "install with another hooks path" $clean in_sandbox "$root/install.sh"
expect "install keeps that hooks path" $clean test /somewhere/else = "$(hooks_path)"

: >"$GIT_CONFIG_GLOBAL"
expect "no terms configured" $clean push

echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
