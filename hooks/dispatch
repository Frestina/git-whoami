#!/usr/bin/env bash
# Global git hooks (core.hooksPath in ~/.gitconfig). Each hook name here is a
# symlink to this script. It runs the identity guard where it applies, then the
# repo's own .git/hooks/<name>, which a global core.hooksPath would otherwise hide.
hook=$(basename "$0")
# git-whoami from the same checkout as this script, else whatever is on PATH.
self=$(readlink -f "$0" 2>/dev/null) || self=$0
whoami="$(dirname "$self")/../bin/git-whoami"
[ -x "$whoami" ] || whoami=$(command -v git-whoami) || {
	case $hook in pre-commit|pre-push)
		echo "$hook: git-whoami not found, so the identity check is skipped" >&2 ;;
	esac
	whoami=true
}
stdin=""

case $hook in
	pre-commit)
		"$whoami" --check || exit 1 ;;
	pre-push)
		stdin=$(cat)
		printf '%s\n' "$stdin" | "$whoami" --pre-push "$1" "$2" || exit 1 ;;
esac

repo_hook="$(git rev-parse --git-common-dir)/hooks/$hook"
[ -x "$repo_hook" ] || exit 0
if [ "$hook" = pre-push ]; then
	printf '%s\n' "$stdin" | "$repo_hook" "$@"
else
	exec "$repo_hook" "$@"
fi
