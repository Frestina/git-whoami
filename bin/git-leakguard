#!/usr/bin/env bash
# git-leakguard: stop a push that would publish something private.
#
# The list lives in git config next to your identities, so it is never in a
# repo that could be pushed:
#
#   [leak]
#     term = my-laptop                     # literal, any case (A-Z only), anywhere in a line
#     regex = "ghp_[a-z0-9]{36}"           # awk regex, matched against the
#                                          # lowercased line: write it in lowercase
#     private = alice/notes                # owner/repo, pushes to it aren't checked
#   [leak "alice-work"]
#     term = alice-personal                # only while alice-work is active
#
# A push is checked for added lines, new file names, author and committer names
# and emails, commit and tag messages, and ref names. Terms also search binary
# files; regexes don't, because a short one matches random bytes. Only pushes to
# github.com are checked, and every repo counts as public unless leak.private
# names it. Commits already on the remote being pushed to, or on one that can be
# read without logging in, aren't checked again.
#
# Usage:
#   git leakguard                   check the whole history of this repo, including
#                                   a repo listed as private (run before going public)
#   git leakguard --pre-push REMOTE URL
#                                   check the commits being pushed, read from stdin
#                                   as git passes them (pre-push hook)
set -u

die() { echo "git-leakguard: $*" >&2; exit 2; }

if ((BASH_VERSINFO[0] * 100 + BASH_VERSINFO[1] < 404)); then
	# With nothing to check, an old bash shouldn't stop a push.
	git config --get-regexp '^leak\.' >/dev/null 2>&1 || exit 0
	die "needs bash 4.4 or newer (this is $BASH_VERSION)"
fi

git rev-parse --git-dir >/dev/null 2>&1 || die "not in a git repository"

mode=all push_remote="" push_url=""
while [ $# -gt 0 ]; do
	case $1 in
		--pre-push) mode=pre-push; push_remote=${2-}; push_url=${3-}; shift 2 ;;
		-h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
		*) die "unknown argument: $1" ;;
	esac
	shift
done

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Starts the scanner's marker lines, so that no commit message can imitate one.
mark=@@@$RANDOM$RANDOM

# One rule per line: "t <term>" or "r <regex>".
active=$(git config identity.active) || active=""
rules=$(
	for section in leak ${active:+"leak.$active"}; do
		git config --get-all "$section.term" | sed 's/^/t /'
		git config --get-all "$section.regex" | sed 's/^/r /'
	done
)

if [ -z "$rules" ]; then
	[ $mode = all ] && echo "No leak terms configured (need leak.term in git config)."
	exit 0
fi

# Sets url_host, or leaves it empty for a local path.
parse_host() {
	local url=$1
	url_host=""
	case $url in
		*://*) url_host=${url#*://}; url_host=${url_host%%/*}; url_host=${url_host#*@}; url_host=${url_host%%:*} ;;
		*:*) case ${url%%:*} in */*) ;; *) url_host=${url%%:*}; url_host=${url_host#*@} ;; esac ;;
	esac
}

# True when URL is a GitHub repo that isn't listed as private. Sets url_slug.
checked_remote() {
	local url=$1 real="" rest p
	parse_host "$url"
	[ -n "$url_host" ] || return 1
	case $url in
		http://*|https://*) ;;
		*) real=$(ssh -G "$url_host" 2>/dev/null </dev/null | awk '$1 == "hostname" { print $2 }') ;;
	esac
	case $(lower "${real:-$url_host}") in
		github.com|ssh.github.com) ;;
		*) return 1 ;;
	esac
	url_slug=${url%/}; url_slug=${url_slug%.git}
	rest=${url_slug%/*}
	url_slug="${rest##*[:/]}/${url_slug##*/}"
	while IFS= read -r p; do
		[ "$(lower "$p")" = "$(lower "$url_slug")" ] && return 1
	done < <(git config --get-all leak.private)
	return 0
}

# True when anyone can read url_slug. This leaves your config and credentials
# behind: a url.insteadOf rule or a login would make a private repo look public.
# No answer in time counts as private, so a stuck network can't hold up a push.
readable_anonymously() {
	local asker timer status
	(
		cd / || exit 1
		unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT
		HOME=/nonexistent GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
			GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true \
			exec git ls-remote "https://github.com/$url_slug.git" HEAD
	) >/dev/null 2>&1 </dev/null &
	asker=$!
	{ sleep "${GIT_LEAKGUARD_TIMEOUT:-10}"; kill "$asker"; } >/dev/null 2>&1 </dev/null &
	timer=$!
	wait "$asker" 2>/dev/null
	status=$?
	kill "$timer" 2>/dev/null
	return "$status"
}

# Prints commits in the form the scanner reads.
commits() {
	git -c core.quotePath=false log --format="${mark}commit %H%n%an <%ae>%n%cn <%ce>%n%B%n${mark}diff" \
		--patch --root --unified=0 --text --no-renames --no-ext-diff --no-textconv \
		--no-color --src-prefix=a/ --dst-prefix=b/ --diff-merges=first-parent \
		"$@" || exit 3
}

tag_blob() { # <blob> [path]
	printf '%sblob %s\n' "$mark" "$1"
	[ -z "${2-}" ] || printf '%s\n' "$2"
	git cat-file blob "$1" || exit 3
	echo
}

# An annotated tag's own text is not part of any commit, and neither is a blob
# or tree that a tag points at. A tag can also point at another tag.
tag_object() {
	local obj=$1 kind path
	while :; do
		kind=$(git cat-file -t "$obj") || exit 3
		[ "$kind" = tag ] || break
		printf '%scommit %s\n' "$mark" "$obj"
		git cat-file -p "$obj" || exit 3
		read -r _ obj < <(git cat-file -p "$obj")
	done
	case $kind in
		blob) tag_blob "$obj" ;;
		tree)
			while read -r _ kind obj path; do
				[ "$kind" = blob ] && tag_blob "$obj" "$path"
			done < <(git -c core.quotePath=false ls-tree -r "$obj") ;;
	esac
}

# A commit on the remote being pushed to, or on a public one, is out already,
# such as the history of a fork's upstream. One that is only on a private remote
# still counts. Tracking refs come from the fetch URL, so that's the one to judge.
public_remotes() {
	local r
	while read -r r; do
		if [ "$r" = "$push_remote" ] ||
			{ checked_remote "$(git remote get-url "$r")" && readable_anonymously; }; then
			printf '%s\n' "--remotes=$r"
		fi
	done < <(git remote)
}

stream() {
	local local_sha remote_ref remote_sha obj range public
	if [ $mode = all ]; then
		git for-each-ref --format="${mark}ref %(refname)" refs/heads refs/tags
		while read -r obj; do
			tag_object "$obj"
		done < <(git for-each-ref --format='%(objectname)' refs/tags)
		commits --branches --tags --remotes
		return
	fi
	mapfile -t public < <(public_remotes)
	while read -r _ local_sha remote_ref remote_sha; do
		# An all-zero sha is a branch deletion: nothing to check.
		[ -n "${local_sha:-}" ] && [ -n "${local_sha//0/}" ] || continue
		printf '%sref %s\n' "$mark" "$remote_ref"
		tag_object "$local_sha"
		range=("$local_sha" --not "${public[@]}")
		[ -n "${remote_sha//0/}" ] && git cat-file -e "$remote_sha" 2>/dev/null &&
			range+=("$remote_sha")
		commits "${range[@]}"
	done
}

if [ $mode = pre-push ]; then
	checked_remote "$push_url" || { cat >/dev/null; exit 0; }
fi

# Older mawk ignores {n} in a regex and can't see past a NUL byte, so it would
# let a leak through. Better to stop here than to pass a push it didn't check.
awk=$(command -v gawk) || awk="awk"
# shellcheck disable=SC2016
probe='BEGIN { nul = sprintf("%c", 0) } /a{2}/ && index($0, nul) && index($0, "b") { print "ok" }'
[ "$(printf 'aa\0b\n' | LC_ALL=C "$awk" "$probe" 2>/dev/null)" = ok ] ||
	die "this awk can miss leaks (it needs {n} in regexes and NUL bytes in lines), so install gawk"

while IFS= read -r rule; do
	case $rule in r\ *) ;; *) continue ;; esac
	bare=${rule//\\?/}
	case ${bare#r } in *[[:upper:]]*)
		echo "git-leakguard: regex ${rule#r} has uppercase letters, which never match: lines are lowercased first" >&2 ;;
	esac
done <<<"$rules"

# shellcheck disable=SC2016
scan='
BEGIN { nul = sprintf("%c", 0) }
FNR == NR {
	n++
	kind[n] = substr($0, 1, 1)
	pat[n] = substr($0, 3)
	if (kind[n] == "t") pat[n] = tolower(pat[n])
	next
}
function check(line, where,    i, lc, hit) {
	lc = tolower(line)
	for (i = 1; i <= n; i++) {
		if (kind[i] == "r" && binary) continue
		hit = kind[i] == "t" ? index(lc, pat[i]) : lc ~ pat[i]
		if (!hit || (where SUBSEP pat[i]) in seen) continue
		seen[where, pat[i]] = 1
		if (++found <= 20) printf "  %s %s: %s\n", commit, where, pat[i]
	}
}
index($0, mark "ref ") == 1 { commit = "ref"; state = "meta"; check(substr($0, length(mark) + 5), "name"); next }
index($0, mark "commit ") == 1 { commit = substr($2, 1, 9); state = "meta"; binary = 0; next }
index($0, mark "blob ") == 1 { commit = substr($2, 1, 9); state = "blob"; binary = 0; next }
$0 == mark "diff" { state = "diff"; file = ""; next }
state == "meta" { check($0, "message or author"); next }
state == "blob" {
	if (index($0, nul)) binary = 1
	check($0, "tagged file")
	next
}
/^diff --git / { len = (length($0) - 16) / 2; file = substr($0, length($0) - len + 1); binary = 0; hunk = 0; next }
/^new file mode/ { check(file, file); next }
/^@@ / { hunk = 1; next }
hunk && /^\+/ {
	if (index($0, nul)) binary = 1
	check(substr($0, 2), file)
}
END {
	if (found > 20) printf "  ...and %d more\n", found - 20
	exit found > 0
}'

report=$(
	stream | LC_ALL=C "$awk" -v mark="$mark" "$scan" <(printf '%s\n' "$rules") -
	statuses=("${PIPESTATUS[@]}")
	[ "${statuses[0]}" -eq 0 ] || exit 3
	exit "${statuses[1]}"
)
case $? in
	0) [ $mode = all ] && echo "No leaks found."; exit 0 ;;
	1) ;;
	3) die "could not read the commits" ;;
	*) die "scan failed; check leak.regex in your git config" ;;
esac

if [ $mode = all ]; then
	echo "Found in this repo's history:"
	printf '%s\n' "$report"
	exit 1
fi

{
	echo
	echo "Leak: this push would publish something on your private list${active:+ (as $active)}:"
	printf '%s\n' "$report"
	echo
	echo "Take it out of those commits (amend or rebase), then push again."
	echo "If this repo is private, list it:"
	echo "  git config --global --add leak.private <owner>/<repo>"
	echo "To bypass once: --no-verify"
} >&2
exit 1
